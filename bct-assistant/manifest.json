{
  "manifest_version": 3,
  "name": "BCT Legal Assistant",
  "version": "1.1.0",
  "description": "AI legal assistant that extracts BCT PDF laws on-the-fly and answers MSME compliance questions with citations.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.bct.gov.tn/*",
    "https://www.bct.gov.tn/bct/siteprod/documents/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BCT Legal Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bct.gov.tn/*",
        "https://www.bct.gov.tn/bct/siteprod/documents/*.pdf"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf.worker.min.mjs",
        "pdf.min.mjs",
        "dashboard/*"
      ],
      "matches": ["https://www.bct.gov.tn/*"]
    }
  ]
}
